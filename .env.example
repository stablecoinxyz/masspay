# (optional) staging or production
# NEXT_PUBLIC_APP_ENV=

# get an api key from https://dashboard.pimlico.io/
NEXT_PUBLIC_PIMLICO_API_KEY=""

# get an project id from https://cloud.reown.com/ (walletconnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

NEXT_PUBLIC_SPONSORSHIP_POLICY_ID=""

# Custom RPC URLs (optional - overrides defaults)
# NEXT_PUBLIC_LOCALHOST_RPC_URL="http://localhost:8545"
# NEXT_PUBLIC_BASE_RPC_URL="https://base-rpc.publicnode.com"
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://base-sepolia-rpc.publicnode.com"
# NEXT_PUBLIC_RADIUS_TESTNET_RPC_URL="https://rpc.testnet.radiustech.xyz"
# NEXT_PUBLIC_RADIUS_MAINNET_RPC_URL="https://rpc.radiustech.xyz/"

# -----------------------------------------------------------------------------
# Account Abstraction bundler URLs — SERVER-ONLY (no NEXT_PUBLIC_ prefix).
#
# These carry the upstream API key and are read only by the server proxy route
# (src/app/api/aa/[chain]/route.ts). The browser talks to /api/aa/{chain}, which
# forwards here — so the key is never shipped to the client bundle.
#
# Set these in Vercel Project Settings > Environment Variables (NOT exposed to
# the browser). Do NOT re-add a NEXT_PUBLIC_ copy — that would re-expose the key.
#
# Full form: https://api.aa.stablecoin.xyz/rpc/v1/{chain}/{API_KEY}
AA_BASE_URL=""
AA_BASE_URL_STAGING=""
AA_BASE_SEPOLIA_URL=""
AA_BASE_SEPOLIA_URL_STAGING=""
AA_RADIUS_URL=""
AA_RADIUS_URL_STAGING=""
AA_RADIUS_TESTNET_URL=""
AA_RADIUS_TESTNET_URL_STAGING=""