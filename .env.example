# (optional) staging or production
# NEXT_PUBLIC_APP_ENV=

# get an api key from https://dashboard.pimlico.io/
NEXT_PUBLIC_PIMLICO_API_KEY=""

# get an project id from https://cloud.reown.com/ (walletconnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

NEXT_PUBLIC_SPONSORSHIP_POLICY_ID=""

# Radius Testnet Account Abstraction URLs
# These point to the bundler service that handles UserOperations
# NEXT_PUBLIC_AA_RADIUS_TESTNET_URL=""
# NEXT_PUBLIC_AA_RADIUS_TESTNET_URL_STAGING=""

# Base Sepolia Account Abstraction URLs (if using Base Sepolia)
# NEXT_PUBLIC_AA_BASE_SEPOLIA_URL=""
# NEXT_PUBLIC_AA_BASE_SEPOLIA_URL_STAGING=""

# Base Account Abstraction URLs (if using Base mainnet)
# NEXT_PUBLIC_AA_BASE_URL=""
# NEXT_PUBLIC_AA_BASE_URL_STAGING=""