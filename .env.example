# (optional) staging or production
# NEXT_PUBLIC_APP_ENV=

# get an api key from https://dashboard.pimlico.io/
NEXT_PUBLIC_PIMLICO_API_KEY=""

# get an project id from https://cloud.reown.com/ (walletconnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

NEXT_PUBLIC_SPONSORSHIP_POLICY_ID=""

# Custom RPC URLs (optional - overrides defaults)
# NEXT_PUBLIC_LOCALHOST_RPC_URL="http://localhost:8545"
# NEXT_PUBLIC_BASE_RPC_URL="https://base-rpc.publicnode.com"
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://base-sepolia-rpc.publicnode.com"
# NEXT_PUBLIC_RADIUS_TESTNET_RPC_URL="https://rpc.testnet.radiustech.xyz"
# NEXT_PUBLIC_RADIUS_MAINNET_RPC_URL="https://rpc.radiustech.xyz/"

# Radius Testnet Account Abstraction URLs
# These point to the bundler service that handles UserOperations
# NEXT_PUBLIC_AA_RADIUS_TESTNET_URL=""
# NEXT_PUBLIC_AA_RADIUS_TESTNET_URL_STAGING=""

# Radius Mainnet Account Abstraction URLs
# These point to the bundler service that handles UserOperations
NEXT_PUBLIC_AA_RADIUS_URL=""
NEXT_PUBLIC_AA_RADIUS_URL_STAGING=""

# Paymaster Service URLs (for pm_getPaymasterData calls)
NEXT_PUBLIC_RADIUS_TESTNET_PAYMASTER_SERVICE_URL=""
NEXT_PUBLIC_RADIUS_PAYMASTER_SERVICE_URL=""

# Bundler URLs (for eth_sendUserOperation calls)
NEXT_PUBLIC_RADIUS_TESTNET_BUNDLER_URL=""
NEXT_PUBLIC_RADIUS_BUNDLER_URL=""

# Base Sepolia Account Abstraction URLs (if using Base Sepolia)
NEXT_PUBLIC_AA_BASE_SEPOLIA_URL=""
NEXT_PUBLIC_AA_BASE_SEPOLIA_URL_STAGING=""

# Base Account Abstraction URLs (if using Base mainnet)
NEXT_PUBLIC_AA_BASE_URL=""
NEXT_PUBLIC_AA_BASE_URL_STAGING=""